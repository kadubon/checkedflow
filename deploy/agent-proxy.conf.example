# Operator-reviewed example; not a provisioner. Supply certificates before starting Nginx.
# These paths are deployment conventions, not bundled keys or operator machine paths.
# Bind remains loopback. Any cross-host listener change needs an approved inventory.
events { worker_connections 256; }
http {
    access_log off;
    server_tokens off;
    client_max_body_size 8m;
    server {
        listen 127.0.0.1:8443 ssl;
        server_name agent.example;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_certificate /etc/checkedflow/proxy/server-chain.pem;
        ssl_certificate_key /etc/checkedflow/proxy/server-key.pem;
        ssl_client_certificate /etc/checkedflow/proxy/client-ca.pem;
        ssl_verify_client on;
        ssl_session_tickets off;
        location / {
            proxy_pass https://127.0.0.1:8080;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_ssl_name checkedflow.internal;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/checkedflow/proxy/backend-ca.pem;
            proxy_ssl_certificate /etc/checkedflow/proxy/backend-client-chain.pem;
            proxy_ssl_certificate_key /etc/checkedflow/proxy/backend-client-key.pem;
            proxy_ssl_session_reuse off;
            proxy_http_version 1.1;
            proxy_set_header Host 127.0.0.1:8080;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Connection "";
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_buffering off;
            proxy_read_timeout 310s;
        }
    }
}
