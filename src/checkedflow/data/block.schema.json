{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkedflow:block:v1",
  "type": "object",
  "properties": {
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "transactions": {
      "type": "array",
      "maxItems": 2097152,
      "items": {
        "type": "object",
        "properties": {
          "raw": {
            "type": "string",
            "maxLength": 2097152,
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "raw",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "height",
    "transactions"
  ],
  "additionalProperties": false
}
