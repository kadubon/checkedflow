{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkedflow:generator:v1",
  "type": "object",
  "properties": {
    "target": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 4
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "library": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4
          }
        },
        "required": [
          "id",
          "operations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "target",
    "max_candidates",
    "max_depth",
    "library"
  ],
  "additionalProperties": false
}
