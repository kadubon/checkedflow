{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckedFlow v2 signed envelope",
  "description": "Lexical JSON restrictions and identity authority additionally require authenticated runtime admission. This schema does not define command semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "signatures"
  ],
  "properties": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "chain",
        "epoch",
        "id",
        "actor",
        "revision",
        "nonce",
        "kind",
        "payload"
      ],
      "properties": {
        "api_version": {
          "const": "checkedflow/v2"
        },
        "chain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nonce": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signer",
          "revision",
          "signature"
        ],
        "properties": {
          "signer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          }
        }
      }
    }
  }
}
