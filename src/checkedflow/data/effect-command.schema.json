{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckedFlow v2 external effect command body",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "effect.prepare"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission",
            "candidate",
            "ticket",
            "intent",
            "policy",
            "executor",
            "revision",
            "expires",
            "lease_blocks"
          ],
          "properties": {
            "mission": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "candidate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "ticket": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "intent": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "policy": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "executor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "expires": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "lease_blocks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "effect.authorize"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission",
            "effect"
          ],
          "properties": {
            "mission": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "effect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "effect.deny"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission",
            "effect"
          ],
          "properties": {
            "mission": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "effect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "effect.reserve"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission",
            "effect"
          ],
          "properties": {
            "mission": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "effect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "effect.report"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission",
            "effect",
            "outcome",
            "number",
            "evidence",
            "fence"
          ],
          "properties": {
            "mission": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "effect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "outcome": {
              "enum": [
                "observed",
                "unknown"
              ]
            },
            "number": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "evidence": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "fence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "effect.reconcile"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission",
            "effect",
            "outcome",
            "number",
            "evidence"
          ],
          "properties": {
            "mission": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "effect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "outcome": {
              "enum": [
                "observed",
                "unknown"
              ]
            },
            "number": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "evidence": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        }
      }
    }
  ]
}
