{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckedFlow bounded file-replacement patch",
  "description": "Structure only. The approved contract additionally binds exact raw bytes, paths, preimages, resulting tree and resource limits. This does not grant execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "changes"],
  "properties": {
    "version": {"const": "repository-patch/v1"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "before", "content"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240},
          "before": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
          "content": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 262144}]}
        }
      }
    }
  }
}
