{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retention backup checkpoint metadata; independent authentication required",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "namespace",
    "scope",
    "revision",
    "height",
    "digest",
    "length",
    "records"
  ],
  "properties": {
    "version": {
      "const": "checkedflow/retention-backup/v1"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,80}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199252740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1100000
    }
  }
}
