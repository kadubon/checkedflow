{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkedflow:state:v1",
  "$defs": {
    "worker": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "organization",
        "roles",
        "revoked"
      ],
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exhaustive": {
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "image",
        "argv",
        "exhaustive"
      ],
      "additionalProperties": false
    },
    "mission": {
      "type": "object",
      "properties": {
        "workers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verification_reserve": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verification_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "receiver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "workers",
        "budget",
        "verification_reserve",
        "verification_cost",
        "expires",
        "max_rounds",
        "max_candidates",
        "max_depth",
        "max_attempts",
        "spent",
        "reserved",
        "candidates",
        "uses",
        "verifier",
        "receiver",
        "contract",
        "image"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "mission": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ttl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "funded": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spec": {
          "type": "object"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "mission",
        "phase",
        "effect",
        "organization",
        "subject",
        "status",
        "owner",
        "cost",
        "ttl",
        "fence",
        "deadline",
        "attempts",
        "funded",
        "dependencies",
        "spec",
        "result"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "mission": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_digest": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "behavior": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "votes": {
          "type": "object"
        }
      },
      "required": [
        "mission",
        "source",
        "source_digest",
        "task",
        "status",
        "behavior",
        "origin",
        "round",
        "depth",
        "expires",
        "dependencies",
        "votes"
      ],
      "additionalProperties": false
    },
    "residual": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "subject",
        "reason",
        "trigger",
        "status",
        "resolution"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "organizations": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/worker"
      }
    },
    "verifiers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/verifier"
      }
    },
    "missions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/mission"
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    },
    "residuals": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/residual"
      }
    },
    "processed": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "nonces": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "chain",
    "height",
    "organizations",
    "workers",
    "verifiers",
    "missions",
    "tasks",
    "capabilities",
    "residuals",
    "processed",
    "nonces"
  ],
  "additionalProperties": false
}
