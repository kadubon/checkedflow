{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckedFlow protected local legacy retention v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalog",
    "objects",
    "namespace",
    "scope",
    "principal",
    "floor",
    "initial",
    "retained",
    "policy"
  ],
  "properties": {
    "version": {
      "const": "checkedflow/legacy-retention-local/v1"
    },
    "catalog": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "objects": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "floor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "initial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "height",
        "state_hash"
      ],
      "properties": {
        "chain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "height": {
          "const": 0
        },
        "state_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "snapshot",
        "history",
        "pin"
      ],
      "properties": {
        "version": {
          "const": "checkedflow/legacy-retained/v1"
        },
        "snapshot": {
          "$ref": "#/$defs/reference"
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "maxItems": 127,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "pin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "identity",
            "sequence",
            "principal"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "principal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_blocks",
        "grace_blocks",
        "object_limit",
        "byte_limit"
      ],
      "properties": {
        "retention_blocks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "grace_blocks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "object_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "byte_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "title": "CheckedFlow artifact reference v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "algorithm",
        "digest",
        "length",
        "content_type",
        "kind",
        "scope",
        "manifest"
      ],
      "properties": {
        "version": {
          "const": "checkedflow/artifact/v1"
        },
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "content_type": {
          "enum": [
            "application/json",
            "application/octet-stream",
            "text/plain"
          ]
        },
        "kind": {
          "enum": [
            "source-tree",
            "patch",
            "evidence",
            "archive",
            "snapshot"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9_-]+(?![\\s\\S])"
        },
        "manifest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
