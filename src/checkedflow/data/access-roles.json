{
  "profile": "checkedflow/access-roles/v1",
  "roles": {
    "inspect": [],
    "submit": [
      "task.lease",
      "task.start",
      "task.heartbeat",
      "task.finish"
    ],
    "approve": [
      "task.admit",
      "artifact.admit",
      "budget.reserve"
    ],
    "verify": [
      "artifact.attest",
      "artifact.withdraw"
    ],
    "revoke": [
      "key.revoke",
      "artifact.revoke",
      "task.cancel"
    ],
    "operate": [
      "mission.pause",
      "mission.drain",
      "mission.resume",
      "journal.rollover",
      "history.archive",
      "key.schedule",
      "budget.configure",
      "budget.settle"
    ]
  },
  "callback_role": "inspect",
  "command_protocol": "checkedflow/v2"
}
